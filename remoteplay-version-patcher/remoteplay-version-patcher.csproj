<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 32-bit: runs everywhere (native on x86, via WOW64 on x64, emulated on ARM64). -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <RootNamespace>remoteplay_version_patcher</RootNamespace>
    <AssemblyName>remoteplay-version-patcher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>remoteplay-version-patcher</Product>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ressy" Version="2.0.0" />
  </ItemGroup>

</Project>
